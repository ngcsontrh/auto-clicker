<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoClicker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AutoClicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Main layout: timing controls above click options and repeat settings. -->
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Click interval: configure the delay between clicks and optional random variation. -->
        <Grid 
            Grid.Row="0" 
            Margin="16,10,16,0">
            <Border
                Padding="16,20,16,16"
                BorderBrush="DarkGray"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <NumberBox
                                Width="65"
                                HorizontalAlignment="Right"
                                Value="{x:Bind ViewModel.IntervalHours, Mode=TwoWay}" />

                            <TextBlock VerticalAlignment="Center" Text="Hours" />
                        </StackPanel>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <NumberBox
                                Width="65"
                                HorizontalAlignment="Right"
                                Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" />

                            <TextBlock VerticalAlignment="Center" Text="Mins" />
                        </StackPanel>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <NumberBox
                                Width="65"
                                HorizontalAlignment="Right"
                                Value="{x:Bind ViewModel.IntervalSeconds, Mode=TwoWay}" />

                            <TextBlock VerticalAlignment="Center" Text="Secs" />
                        </StackPanel>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <NumberBox
                                Width="65"
                                HorizontalAlignment="Right"
                                Value="{x:Bind ViewModel.IntervalMilliseconds, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Text="Miliseconds" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Random offset"
                                IsChecked="{x:Bind ViewModel.IsRandomOffsetEnabled, Mode=TwoWay}" />
                            <NumberBox
                                Width="65"
                                VerticalAlignment="Center"
                                Value="{x:Bind ViewModel.RandomOffsetMilliseconds, Mode=TwoWay}" />

                            <TextBlock VerticalAlignment="Center" Text="Miliseconds" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border
                Margin="24,-10,0,0"
                Padding="4,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <TextBlock FontSize="12" Text="Click interval" />
            </Border>
        </Grid>

        <!-- Click behavior: choose the mouse action and how many times it repeats. -->
        <Grid
            Grid.Row="1"
            Margin="16,10,16,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Click options: select the mouse button and single or double click. -->
            <Grid Grid.Column="0">
                <Border
                    Padding="16,20,16,16"
                    BorderBrush="DarkGray"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="Mouse button:" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="96"
                            SelectedIndex="{x:Bind ViewModel.MouseButtonIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Left" />
                            <ComboBoxItem Content="Right" />
                            <ComboBoxItem Content="Middle" />
                        </ComboBox>
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Click type:" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="96"
                            SelectedIndex="{x:Bind ViewModel.ClickTypeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Single" />
                            <ComboBoxItem Content="Double" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border
                    Margin="24,-10,0,0"
                    Padding="4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TextBlock FontSize="12" Text="Click options" />
                </Border>
            </Grid>

            <!-- Click repeat: repeat a fixed number of times or until stopped. -->
            <Grid Grid.Column="1">
                <Border
                    Padding="16,20,16,16"
                    BorderBrush="DarkGray"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <RadioButton
                                Content="Repeat"
                                GroupName="RepeatMode"
                                IsChecked="{x:Bind ViewModel.IsFixedRepeat, Mode=TwoWay}" />
                            <NumberBox
                                Width="96"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.RepeatCount, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Text="times" />
                        </StackPanel>
                        <RadioButton
                            Content="Repeat until stopped"
                            GroupName="RepeatMode"
                            IsChecked="{x:Bind ViewModel.RepeatUntilStopped, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="24,-10,0,0"
                    Padding="4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TextBlock FontSize="12" Text="Click repeat" />
                </Border>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="16,10,16,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border
                    Padding="16,20,16,16"
                    BorderBrush="DarkGray"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid
                        VerticalAlignment="Center"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton
                            Grid.Row="0"
                            Grid.ColumnSpan="6"
                            Content="Current position"
                            GroupName="CursorPosition"
                            IsChecked="{x:Bind ViewModel.UseCurrentLocation, Mode=TwoWay}" />
                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Pick location"
                            GroupName="CursorPosition"
                            IsChecked="{x:Bind ViewModel.UseSelectedLocation, Mode=TwoWay}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            Padding="0"
                            Margin="-15,0,30,0"
                            AutomationProperties.Name="Pick location"
                            IsEnabled="{x:Bind ViewModel.CanPickLocation, Mode=OneWay}"
                            Command="{x:Bind ViewModel.PickLocationCommand}"
                            ToolTipService.ToolTip="Move the pointer to the desired screen location and click. Press Esc to cancel.">
                            <Canvas Width="18" Height="24">
                                <Path
                                    Data="M9,1 C4.6,1 1,4.6 1,9 V15 C1,19.4 4.6,23 9,23 C13.4,23 17,19.4 17,15 V9 C17,4.6 13.4,1 9,1 Z M9,1 V8"
                                    Fill="Transparent"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="X" />
                        <NumberBox
                            Grid.Row="1"
                            Grid.Column="3"
                            Width="50"
                            Value="{x:Bind ViewModel.CursorX, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Text="Y" />
                        <NumberBox
                            Grid.Row="1"
                            Grid.Column="5"
                            Width="50"
                            Value="{x:Bind ViewModel.CursorY, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border
                    Margin="24,-10,0,0"
                    Padding="4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TextBlock FontSize="12" Text="Cursor position" />
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Border
                    Padding="16,20,16,16"
                    BorderBrush="DarkGray"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid
                        VerticalAlignment="Center"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="Hotkey setting:" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="96"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Content="{x:Bind ViewModel.HotkeyKey, Mode=OneWay}"
                            Click="HotkeySettingButton_Click" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Theme:" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="96"
                            HorizontalAlignment="Left"
                            SelectedValuePath="Content"
                            SelectedValue="{x:Bind ViewModel.ThemeMode, Mode=TwoWay}">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border
                    Margin="24,-10,0,0"
                    Padding="4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TextBlock FontSize="12" Text="Settings" />
                </Border>
            </Grid>
        </Grid>

        <!-- Start/stop control. -->
        <Grid
            Grid.Row="3"
            Margin="16,10,16,0"
            HorizontalAlignment="Stretch">
            <Button
                x:Name="StartButton"
                HorizontalAlignment="Stretch"
                Height="40"
                Style="{StaticResource AccentButtonStyle}"
                Content="{x:Bind ViewModel.StartStopText, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleRunningCommand}" />
        </Grid>
    </Grid>
</Page>
